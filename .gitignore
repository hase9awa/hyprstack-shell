# Only the public source tree is eligible for version control.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/README.md
!/README.en.md
!/INSTALL.md
!/INSTALL.en.md
!/CONFIGURATION.md
!/MAINTENANCE.md
!/CHANGELOG.md
!/update.sh
!/THIRD_PARTY.md
!/flake.nix
!/flake.lock
!/nix/
/nix/*
!/nix/package.nix
!/nix/nixos-module.nix
!/nix/home-manager.nix

!/distribution/
/distribution/*
!/distribution/bin/
!/distribution/check_headers.py
!/distribution/update.py
!/distribution/update_transaction.py
!/distribution/defaults/
!/distribution/systemd/
!/distribution/patches/

!/native/
/native/*
!/native/hyprbars/
/native/hyprbars/*
!/native/hyprbars/*.cpp
!/native/hyprbars/*.hpp
!/native/hyprbars/LICENSE

!/third_party/
/third_party/*
!/third_party/m3shapes/
/third_party/m3shapes/*
!/third_party/m3shapes/CMakeLists.txt
!/third_party/m3shapes/LICENSE
!/third_party/m3shapes/cmake/
!/third_party/m3shapes/include/
!/third_party/m3shapes/src/

!/shell/
/shell/*
!/shell/CMakeLists.txt
!/shell/LICENSE
!/shell/shell.qml
!/shell/assets/
!/shell/components/
!/shell/extras/
!/shell/modules/
!/shell/plugin/
!/shell/services/
!/shell/utils/
/shell/assets/*
!/shell/assets/diagnostics.py
!/shell/assets/hyprstack_cli.py
!/shell/assets/i18n.py
!/shell/assets/notification_tools.py
!/shell/assets/session_runner.py
!/shell/assets/theme_manager.py
!/shell/assets/theme_sync.py
!/shell/assets/vpn.py
!/shell/assets/vpn_profiles.py
!/shell/assets/wrap_term_launch.sh
!/shell/assets/logo.svg
!/shell/assets/bongocat.gif
!/shell/assets/kurukuru.gif
!/shell/assets/dino.png
!/shell/assets/google-sans-flex/
!/shell/assets/material-symbols/
!/shell/assets/schemes/
!/shell/assets/hyprland/

!/docs/
/docs/*
!/docs/media/
/docs/media/*
!/docs/media/README.md
!/docs/media/showcase.gif
!/docs/media/dashboard.gif
!/docs/media/panel-tools.gif
!/docs/media/customization.gif
!/docs/media/overview.gif
!/docs/media/trackpad-swipes.gif
!/docs/media/app-colours.gif
!/docs/media/vpn.gif

# Generated files and machine-local overrides are never source files.
**/.*
!/.gitignore
!/.gitattributes
**/__pycache__/
*.py[cod]
*.mo
*.qm
*.o
*.a
*.so
*.so.*
*.qsb
*.log
*.tmp
*.bak
*.orig
*.swp
*.swo
**/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/install_manifest.txt
**/node_modules/
**/scheme/current.lua
**/hyprstack/monitors.lua
**/hyprstack/local.lua
# These two files are empty extension points, with no machine configuration.
!/distribution/defaults/hyprstack/monitors.lua
!/distribution/defaults/hyprstack/local.lua
