-void StatusNotifierItem::onGetAllFailed() const {
-	// Not changing the item to ready, as it is almost definitely broken.
+void StatusNotifierItem::onGetAllFailed() {
+	// A client can announce its tray item before the exported object is ready.
+	// Retry initial discovery briefly instead of hiding that item until restart.
+	if (!this->mReady && this->initialLoadRetries < 4) {
+		auto delay = 250 * (1 << this->initialLoadRetries++);
+		qCDebug(logStatusNotifierItem)
+		    << "Retrying tray item" << this->properties.toString() << "after" << delay << "ms";
+		QTimer::singleShot(delay, this, [this]() {
+			if (!this->mReady) this->properties.updateAllViaGetAll();
+		});
+		return;
+	}
+
 	if (!this->mReady) {
 		qWarning(logStatusNotifierItem) << "Failed to load tray item" << this->properties.toString();
 
