#!/usr/bin/env bash
set -euo pipefail
data_dir=${HYPRSTACK_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/hyprstack}
action=${1:-start}
if [[ "$action" != start && "$action" != stop && "$action" != restart ]]; then
    printf 'Usage: hyprstack-session start|stop|restart\n' >&2
    exit 2
fi
if [[ "$action" != stop && ( -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" || -z "${WAYLAND_DISPLAY:-}" ) ]]; then
    printf 'Run this command from a Hyprland session.\n' >&2
    exit 1
fi
export PATH="$PATH:$HOME/.local/bin"
export PYTHONDONTWRITEBYTECODE=1
if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    if [[ "$action" != stop ]]; then
        session_vars=(WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DISPLAY PATH XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME QT_QPA_PLATFORM HYPRSTACK_PAM_SERVICE HYPRSTACK_DATA_DIR HYPRSTACK_TITLEBAR_PLUGIN HYPRSTACK_SESSION_COMMAND)
        defined_vars=()
        for name in "${session_vars[@]}"; do
            if [[ -v "$name" ]]; then defined_vars+=("$name"); fi
        done
        systemctl --user import-environment "${defined_vars[@]}"
        if command -v dbus-update-activation-environment >/dev/null; then
            # The systemd manager already has the session environment. Updating
            # D-Bus activation is optional and must not prevent the desktop unit
            # from starting when that separate request fails.
            if ! dbus-update-activation-environment --systemd "${defined_vars[@]}"; then
                printf 'hyprstack-session: D-Bus activation environment update failed; continuing with the imported systemd environment.\n' >&2
            fi
        fi
        systemctl --user daemon-reload
    fi
    if [[ "$action" == stop ]]; then
        systemctl --user stop hyprstack-session.service 2>/dev/null || true
        exec python3 "$data_dir/shell/assets/session_runner.py" stop
    fi
    systemctl --user "$action" hyprstack-session.service
else
    exec python3 "$data_dir/shell/assets/session_runner.py" "$action"
fi
